					"hide_if_blocked": true,
					"next": "job"
				},
				{
					"text": "그만 간다",
					"next": ""
				}
			]
		},
		"refuse_talk": {
			"speaker": "elder_tarr",
			"text": "…말은 잘하는군. 오늘은 들어 주지. 하지만 저수조에 물 한 통 붓기 전엔 안 믿네.",
			"choices": [
				{
