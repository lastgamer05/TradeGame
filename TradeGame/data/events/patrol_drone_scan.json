{
	"id": "patrol_drone_scan",
	"title": "순찰 드론",
	"trigger": {
		"on": "travel",
		"road_types": ["highway"],
		"requires": [
			{ "type": "cargo", "good": "hacking_tool" }
		],
		"weight": 10
	},
	"text": "헬리오스 순찰 드론이 머리 위에 멈춘다. 푸른 스캔 광선이 짐칸을 훑는다. 해킹 툴이 걸리면 끝이다.",
	"choices": [
		{
			"id": "jam",
			"text": "스캔 신호를 교란한다",
			"check": { "stat": "tech", "dc": 14 },
			"outcomes": {
				"success": {
					"text": "드론 화면에 빈 짐칸이 찍힌다. 드론이 다음 차로 날아간다.",
					"effects": []
				},
				"failure": {
					"text": "교란 신호가 오히려 눈에 띈다. 스피커에서 정지 명령이 나온다.",
					"effects": [
						{ "type": "cargo_remove", "good": "hacking_tool", "amount": "all" },
						{ "type": "reputation", "city": "helios", "delta": -10 },
						{ "type": "flag_set", "flag": "helios_criminal_record" }
					]
				}
			}
		},
		{
			"id": "smuggle_compartment",
			"text": "밀수칸에 옮겨 둔다",
			"requires": [
				{ "type": "module", "module": "smuggle_compartment" }
			],
			"outcomes": {
				"success": {
					"text": "납판 덧댄 밀수칸은 스캔에 안 잡힌다. 드론이 무심하게 떠난다.",
					"effects": []
				}
			}
		},
		{
			"id": "flee",
			"text": "고가도로 아래로 빠진다",
			"check": { "stat": "driving", "dc": 15 },
			"outcomes": {
				"success": {
					"text": "드론이 교각 사이를 못 따라온다. 번호판도 안 찍혔다.",
					"effects": []
				},
				"failure": {
					"text": "드론이 번호판을 찍고 날아간다. 수배 명단에 이름이 오른다.",
					"effects": [
						{ "type": "reputation", "city": "helios", "delta": -8 },
						{ "type": "reputation", "city": "gate7", "delta": -5 },
						{ "type": "flag_set", "flag": "helios_criminal_record" }
					]
				}
			}
		},
		{
			"id": "dump",
			"text": "해킹 툴을 창밖으로 버린다",
			"outcomes": {
				"success": {
					"text": "상자가 도랑으로 굴러떨어진다. 스캔은 깨끗하다. 아까운 물건이었다.",
					"effects": [
						{ "type": "cargo_remove", "good": "hacking_tool", "amount": "all" }
					]
				}
			}
		}
	]
}
